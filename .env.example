# Copiá este archivo a .env.local y completá los valores. Nunca subas .env.local a Git.

# Supabase: proyecto con la tabla `clients` y los usuarios administradores.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave secreta (sb_secret_... o service_role). Solo en el servidor.
SUPABASE_SERVICE_ROLE_KEY=

# Neon: API key de la cuenta (Account settings > API keys). Solo se usa para leer costos e infraestructura.
NEON_API_KEY=

# Opcional: secreto para firmar la sesión. Si falta, se deriva de SUPABASE_SERVICE_ROLE_KEY.
# BETTER_AUTH_SECRET=
